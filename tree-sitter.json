  "grammars": [
    {
      "name": "verilog_ams",
      "camelcase": "VerilogAMS",
      "scope": "source.verilogams",
      "path": ".",
      "file-types": ["va", "vams", "vah"],
      "injection-regex": "^(verilog_ams|verilogams)$",
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Verilog-A and Verilog-AMS 2.4 grammar extending tree-sitter-verilog",
    "authors": [{"name": "Aliaksei Chapyzhenka"}, {"name": "Amaan Qureshi"}]
  },
  "bindings": {"c": true, "rust": true}
}
